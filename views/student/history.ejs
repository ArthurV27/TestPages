<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">HISTORY</span><h1>Borrowing History</h1><p>A chronological record of your library activity.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Book</th><th>Issue date</th><th>Due date</th><th>Return date</th><th>Late days</th><th>Status</th></tr></thead><tbody><% history.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.author %> · <%= r.book_code %></small></td><td><%= r.issue_date %></td><td><%= r.due_date %></td><td><%= r.return_date||'—' %></td><td><%= r.late_days %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td></tr><% }) %><% if(!history.length){ %><tr><td colspan="6" class="center muted">No borrowing history yet.</td></tr><% } %></tbody></table></div></section><%- include('../partials/layout-end') %>
