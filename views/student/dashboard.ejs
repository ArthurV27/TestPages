<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">STUDENT</span><h1>Welcome, <%= currentUser.name.split(' ')[0] %>.</h1><p>Keep an eye on your due dates and discover your next book.</p></div><a class="btn btn-primary" href="/student/catalog">Browse catalog</a></div><% const urgent=current.filter(x=>x.due_date<=new Date(Date.now()+3*86400000).toISOString().slice(0,10)); if(urgent.length){ %><section class="alert-banner <%= urgent.some(x=>x.due_date<new Date().toISOString().slice(0,10))?'danger':'warning' %>"><strong><%= urgent.length %> book(s) need attention.</strong><span><%= urgent.some(x=>x.due_date<new Date().toISOString().slice(0,10))?'You have an overdue book.':'A book is due within 3 days.' %></span><a href="/student/borrowed">View borrowed books →</a></section><% } %><div class="metrics three"><div class="metric"><span>Currently Borrowed</span><strong><%= current.length %></strong><small>Active loans</small></div><div class="metric"><span>Due Soon</span><strong><%= urgent.length %></strong><small>Within 3 days</small></div><div class="metric"><span>History</span><strong><%= history.length %></strong><small>Recent returned books</small></div></div><section class="panel"><div class="panel-head"><div><h2>Recommended for you</h2><p><%= student.course %> · Year <%= student.year_level %> · Section <%= student.section %></p></div><a href="/student/catalog">Browse all →</a></div><div class="book-grid"><% recommendations.forEach(r=>{ %><article class="book-card"><div class="book-cover large"><%= r.title.charAt(0) %></div><div class="book-card-body"><div class="tag-row"><span class="tag">Recommended</span><span class="badge <%= r.available_quantity>0?'available':'borrowed' %>"><%= r.available_quantity>0?'Available':'Out of stock' %></span></div><h3><%= r.title %></h3><p><%= r.author %></p><small><%= r.book_code %> · <%= r.available_quantity %>/<%= r.quantity %> copies</small><a class="btn btn-small btn-primary btn-wide" href="/student/catalog">View in catalog</a></div></article><% }) %><% if(!recommendations.length){ %><div class="empty-inline"><h3>No course recommendations yet</h3><p>The library administrator can assign books for your course and year level.</p></div><% } %></div></section><section class="panel"><div class="panel-head"><div><h2>My borrowed books</h2><p>Current loans and due dates.</p></div><a href="/student/borrowed">See all →</a></div><div class="book-grid"><% current.slice(0,4).forEach(r=>{ %><article class="book-card"><div class="book-cover large"><%= r.title.charAt(0) %></div><div class="book-card-body"><span class="tag"><%= r.book_code %></span><h3><%= r.title %></h3><p><%= r.author %></p><div class="due"><span>Due</span><strong><%= r.due_date %></strong></div><span class="badge <%= r.status %>"><%= r.status %></span></div></article><% }) %><% if(!current.length){ %><div class="empty-inline"><h3>No active loans</h3><p>Explore the catalog to borrow your first book.</p></div><% } %></div></section><section class="panel"><div class="panel-head"><div><h2>Borrowing history</h2><p>Your recently returned books.</p></div><a href="/student/history">Full history →</a></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Issue</th><th>Returned</th><th>Status</th></tr></thead><tbody><% history.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.issue_date %></td><td><%= r.return_date %></td><td><span class="badge returned">returned</span></td></tr><% }) %></tbody></table></div></section><%- include('../partials/layout-end') %>
