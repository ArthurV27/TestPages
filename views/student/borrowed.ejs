<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">MY LOANS</span><h1>My Borrowed Books</h1><p>Current books, issue dates, and due dates.</p></div></div><div class="book-grid"><% loans.forEach(r=>{ const overdue=r.due_date<new Date().toISOString().slice(0,10); %><article class="book-card"><div class="book-cover large"><%= r.title.charAt(0) %></div><div class="book-card-body"><span class="tag"><%= r.book_code %></span><h3><%= r.title %></h3><p><%= r.author %></p><dl class="detail-list"><div><dt>Issued</dt><dd><%= r.issue_date %></dd></div><div><dt>Due</dt><dd class="<%= overdue?'text-danger':'' %>"><%= r.due_date %></dd></div></dl><span class="badge <%= overdue?'overdue':r.status %>"><%= overdue?'overdue':r.status %></span></div></article><% }) %><% if(!loans.length){ %><div class="empty-inline"><h3>You have no active loans.</h3><p>Browse the catalog to find something to read.</p><a class="btn btn-primary" href="/student/catalog">Browse catalog</a></div><% } %></div><%- include('../partials/layout-end') %>
