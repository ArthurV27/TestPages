<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">ACCOUNT</span><h1>My Profile</h1><p>Keep your contact information up to date.</p></div></div><section class="panel form-panel"><form method="post" action="/student/profile"><div class="profile-header"><div class="avatar"><%= student.name.charAt(0) %></div><div><h2><%= student.name %></h2><span class="badge available"><%= student.status %></span></div></div><div class="form-grid"><label>Course<input value="<%= student.course %>" disabled></label><label>Year & Section<input value="Year <%= student.year_level %> · Section <%= student.section %>" disabled></label><label>Name<input name="name" required value="<%= student.name %>"></label><label>Student Number<input value="<%= student.student_number %>" disabled></label><label>Email<input name="email" type="email" required value="<%= student.email||'' %>"></label><label>Contact Number<input name="contact_number" value="<%= student.contact_number||'' %>"></label></div><div class="modal-actions"><button class="btn btn-primary" type="submit">Save changes</button></div></form></section><%- include('../partials/layout-end') %>
