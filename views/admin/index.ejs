<%- include('partials/head', { title }) %>
<%- include('partials/toast') %>

<div class="login-page">

  <section class="login-hero">
    <div class="login-hero-overlay">
      <div class="login-brand">
        <h1>Library System</h1>
        <p>Library Management System</p>
      </div>
    </div>
  </section>

  <section class="login-card">

    <div class="login-card-header">
      <h2>Sign In</h2>
      <p>Choose your account type to continue.</p>
    </div>

    <form
      method="post"
      action="/login"
      id="loginForm"
    >

      <div class="role-selector">

        <label>
          <input
            type="radio"
            name="role"
            value="student"
            checked
          >
          Student
        </label>

        <label>
          <input
            type="radio"
            name="role"
            value="librarian"
          >
          Librarian
        </label>

        <label>
          <input
            type="radio"
            name="role"
            value="admin"
          >
          Admin
        </label>

      </div>

      <div class="form-group">

        <label for="name">
          Full Name
        </label>

        <input
          type="text"
          name="name"
          id="name"
          placeholder="Enter your full name"
          required
        />

      </div>

      <div
        class="form-group"
        id="studentFields"
      >

        <label for="studentNumber">
          Student Number
        </label>

        <input
          type="text"
          name="student_number"
          id="studentNumber"
          placeholder="24-000113"
        />

      </div>

      <div
        class="form-group"
        id="passwordFields"
      >

        <label for="password">
          Password
        </label>

        <input
          type="password"
          name="password"
          id="password"
          placeholder="Enter your password"
          required
          autocomplete="current-password"
        />

      </div>

      <button
        type="submit"
        class="btn btn-primary"
      >
        Sign In
      </button>

    </form>

    <div class="login-footer">

      <p>
        Don't have a student account?
      </p>

      <a href="/register">
        Register Here
      </a>

    </div>

  </section>

</div>

<script>
  const roleInputs =
    document.querySelectorAll('input[name="role"]');

  const studentFields =
    document.getElementById('studentFields');

  const studentNumber =
    document.getElementById('studentNumber');

  function updateLoginFields() {
    const selectedRole =
      document.querySelector(
        'input[name="role"]:checked'
      ).value;

    if (selectedRole === 'student') {
      studentFields.style.display = 'block';
      studentNumber.required = true;
    } else {
      studentFields.style.display = 'none';
      studentNumber.required = false;
      studentNumber.value = '';
    }
  }

  roleInputs.forEach(input => {
    input.addEventListener(
      'change',
      updateLoginFields
    );
  });

  updateLoginFields();
</script>

</body>
</html>