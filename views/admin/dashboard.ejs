<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">ADMINISTRATION</span><h1>System overview.</h1><p>Manage librarians, students, user status, and personalized book recommendations.</p></div><a class="btn btn-primary" href="/admin/users">Manage users</a></div><div class="metrics four"><div class="metric"><span>Librarians</span><strong><%= metrics.librarians %></strong><small>Staff accounts</small></div><div class="metric"><span>Students</span><strong><%= metrics.students %></strong><small>Registered borrowers</small></div><div class="metric"><span>Active Students</span><strong><%= metrics.activeStudents %></strong><small>Can log in</small></div><div class="metric"><span>Books</span><strong><%= metrics.books %></strong><small>Catalog titles</small></div></div><section class="panel"><div class="panel-head"><div><h2>Administration shortcuts</h2><p>Keep the system organized.</p></div></div><div class="action-grid"><a class="action-card" href="/admin/users"><strong>👥 Users & Librarians</strong><span>Add staff, update profiles, activate or suspend accounts.</span></a><a class="action-card" href="/admin/recommendations"><strong>📚 Recommendations</strong><span>Assign books to courses and year levels.</span></a><a class="action-card" href="/librarian/books"><strong>📖 Book Catalog</strong><span>Manage inventory through the librarian workspace.</span></a></div></section><section class="panel"><div class="panel-head"><div><h2>Recently registered users</h2><p>Latest accounts in the system.</p></div><a href="/admin/users">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Role</th><th>Status</th><th>Registered</th></tr></thead><tbody><% recent.forEach(u=>{ %><tr><td><strong><%= u.name %></strong></td><td><span class="tag"><%= u.role %></span></td><td><span class="badge <%= u.status %>"><%= u.status %></span></td><td><%= u.created_at.toISOString ? u.created_at.toISOString().slice(0,10) : u.created_at %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/layout-end') %>
