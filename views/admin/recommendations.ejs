<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">ADMIN</span><h1>Book recommendations.</h1><p>Assign books to a course and year level. Matching students see them on their dashboard.</p></div></div><section class="panel"><div class="panel-head"><div><h2>Add recommendation</h2><p>Example: BS Information Technology + 1st Year → Introduction to Programming.</p></div></div><form method="post" action="/admin/recommendations"><div class="form-grid four"><label>Course<select name="course" required><option value="">Select course</option><% courses.forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></label><label>Year Level<select name="year_level" required><option value="">Year</option><% [1,2,3,4,5,6].forEach(y=>{ %><option value="<%= y %>"><%= y %></option><% }) %></select></label><label>Book<select name="book_id" required><option value="">Select book</option><% books.forEach(b=>{ %><option value="<%= b.id %>"><%= b.title %> · <%= b.book_code %></option><% }) %></select></label><label>Priority<input type="number" name="priority" value="1" min="1" max="99"></label></div><button class="btn btn-primary" type="submit">+ Add recommendation</button></form></section><section class="panel"><div class="panel-head"><div><h2>Current recommendations</h2><p>These appear on matching student dashboards.</p></div></div><div class="table-wrap"><table><thead><tr><th>Course</th><th>Year</th><th>Book</th><th>Priority</th><th>Action</th></tr></thead><tbody><% recommendations.forEach(r=>{ %><tr><td><strong><%= r.course %></strong></td><td>Year <%= r.year_level %></td><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.priority %></td><td><form method="post" action="/admin/recommendations/<%= r.id %>/delete"><button class="btn btn-small btn-ghost" type="submit" data-confirm="Remove this recommendation?">Remove</button></form></td></tr><% }) %><% if(!recommendations.length){ %><tr><td colspan="5"><div class="empty-inline">No recommendations yet.</div></td></tr><% } %></tbody></table></div></section><%- include('../partials/layout-end') %>
