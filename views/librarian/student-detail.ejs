<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><a class="back" href="/librarian/students">← Students</a><h1><%= student.name %></h1><p><%= student.student_number %> · <%= student.email||'No email' %> · <%= student.contact_number||'No contact number' %></p></div></div><section class="panel"><div class="panel-head"><div><h2>Borrowing activity</h2><p>Complete transaction history for this student.</p></div></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Issued</th><th>Due</th><th>Returned</th><th>Status</th><th>Late</th></tr></thead><tbody><% history.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.issue_date %></td><td><%= r.due_date %></td><td><%= r.return_date||'—' %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td><td><%= r.late_days %> day(s)</td></tr><% }) %><% if(!history.length){ %><tr><td colspan="6" class="center muted">No borrowing history.</td></tr><% } %></tbody></table></div></section><%- include('../partials/layout-end') %>
