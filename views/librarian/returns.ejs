<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">TRANSACTIONS</span><h1>Return Management</h1><p>Confirm returns and automatically restore available stock.</p></div></div><div class="toolbar"><input class="search" data-table-search="#returnsTable" placeholder="Search book or student…"></div><section class="panel"><div class="table-wrap"><table id="returnsTable"><thead><tr><th>Book</th><th>Student</th><th>Issue</th><th>Due</th><th>Status</th><th></th></tr></thead><tbody><% loans.forEach(r=>{ %><tr data-search="<%= r.title+' '+r.student_name+' '+r.student_number %>"><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.student_name %><small><%= r.student_number %></small></td><td><%= r.issue_date %></td><td><%= r.due_date %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td><td><form method="post" action="/librarian/returns/<%= r.id %>" data-confirm="Confirm that this book has been returned?"><button class="btn btn-small btn-primary" type="submit">Confirm return</button></form></td></tr><% }) %><% if(!loans.length){ %><tr><td colspan="6" class="center muted">No active loans.</td></tr><% } %></tbody></table></div></section><%- include('../partials/layout-end') %>
