<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">INSIGHTS</span><h1>Reports</h1><p>Simple borrowing, returning, and inventory summaries.</p></div><a class="btn btn-primary" href="/librarian/reports/borrowings.csv">Export CSV</a></div><div class="metrics four"><div class="metric"><span>Transactions</span><strong><%= summary.total_transactions %></strong></div><div class="metric"><span>Returned</span><strong><%= summary.returned %></strong></div><div class="metric"><span>Active</span><strong><%= summary.active %></strong></div><div class="metric danger"><span>Overdue</span><strong><%= summary.overdue %></strong></div></div><section class="panel"><div class="panel-head"><div><h2>Inventory status</h2><p>Current copy availability by title.</p></div></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Category</th><th>Total</th><th>Available</th><th>Borrowed</th></tr></thead><tbody><% inventory.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.category %></td><td><%= r.quantity %></td><td><%= r.available_quantity %></td><td><%= r.borrowed_copies %></td></tr><% }) %></tbody></table></div></section><section class="panel"><div class="panel-head"><div><h2>Borrowing log</h2><p>Printable from the browser or exportable as CSV.</p></div></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Student</th><th>Issue</th><th>Due</th><th>Returned</th><th>Status</th></tr></thead><tbody><% logs.forEach(r=>{ %><tr><td><%= r.title %></td><td><%= r.student_name %></td><td><%= r.issue_date %></td><td><%= r.due_date %></td><td><%= r.return_date||'—' %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td></tr><% }) %></tbody></table></div></section><%- include('../partials/layout-end') %>
