<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">INVENTORY</span><h1>Book Management</h1><p>Add, update, search, and manage book stock.</p></div><button class="btn btn-primary" data-modal="bookModal">+ Add book</button></div><div class="toolbar"><input class="search" data-table-search="#booksTable" placeholder="Search title, author, category, or ID…"><span class="muted">Live search</span></div><section class="panel"><div class="table-wrap"><table id="booksTable"><thead><tr><th>Book</th><th>Author</th><th>Category</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% books.forEach(b=>{ %><tr data-search="<%= b.title+' '+b.author+' '+b.category+' '+b.book_code %>"><td><div class="book-cell"><div class="book-cover"><%= b.title.charAt(0) %></div><div><strong><%= b.title %></strong><small><%= b.book_code %><% if(b.isbn){ %> · ISBN <%= b.isbn %><% } %></small></div></div></td><td><%= b.author %></td><td><span class="tag"><%= b.category %></span></td><td><strong><%= b.available_quantity %></strong> / <%= b.quantity %></td><td><span class="badge <%= b.available_quantity>0?'available':'borrowed' %>"><%= b.available_quantity>0?'Available':'Out of stock' %></span></td><td><div class="action-row"><button class="btn btn-small" data-edit-book='<%- JSON.stringify(b) %>'>Edit</button><form method="post" action="/librarian/books/<%= b.id %>/delete" data-confirm="Delete this book? This will only work if it has no transaction history."><button class="btn btn-small btn-danger" type="submit">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section><div class="modal" id="bookModal"><div class="modal-card"><button class="modal-close" data-close>×</button><h2 id="bookModalTitle">Add book</h2><p class="muted">Keep catalog information complete so students can recognize books quickly.</p><form method="post" id="bookForm" action="/librarian/books"><div class="form-grid"><label>Book ID / Code<input name="book_code" id="book_code" required placeholder="BK-006"></label><label>ISBN<input name="isbn" id="isbn" placeholder="Optional"></label><label class="span-2">Title<input name="title" id="title" required></label><label>Author<input name="author" id="author" required></label><label>Category<input name="category" id="category" required placeholder="Programming"></label><label>Quantity<input name="quantity" id="quantity" type="number" min="1" required></label><label>Cover URL<input name="cover_url" id="cover_url" placeholder="Optional image URL"></label><label class="span-2">Description<textarea name="description" id="description" rows="3"></textarea></label></div><div class="modal-actions"><button class="btn" type="button" data-close>Cancel</button><button class="btn btn-primary" type="submit">Save book</button></div></form></div></div><script src="/js/books.js"></script><%- include('../partials/layout-end') %>
