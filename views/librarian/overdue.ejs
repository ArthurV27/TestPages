<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">ATTENTION</span><h1>Overdue Monitoring</h1><p>Follow up on loans past their due date.</p></div></div><section class="alert-banner danger"><strong><%= overdue.length %> overdue loan(s)</strong><span>Contact details are shown for quick follow-up.</span></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Student</th><th>Book</th><th>Due date</th><th>Days late</th><th>Contact</th></tr></thead><tbody><% overdue.forEach(r=>{ %><tr><td><strong><%= r.student_name %></strong><small><%= r.student_number %></small></td><td><strong><%= r.title %></strong><small><%= r.book_code %></small></td><td><%= r.due_date %></td><td><span class="badge overdue"><%= r.days_late %> day(s)</span></td><td><%= r.email||'—' %><small><%= r.contact_number||'—' %></small></td></tr><% }) %><% if(!overdue.length){ %><tr><td colspan="5" class="center muted">Great—there are no overdue loans.</td></tr><% } %></tbody></table></div></section><%- include('../partials/layout-end') %>
