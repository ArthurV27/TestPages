<%- include('../partials/layout-start',{title}) %>

<div class="page-header">
  <div>
    <span class="eyebrow">LIBRARIAN</span>

    <h1>Dashboard</h1>

    <p>
      Here’s what’s happening across the library.
    </p>
  </div>

  <a
    class="btn btn-primary"
    href="/librarian/borrow"
  >
    + Issue a book
  </a>
</div>


<div class="metrics">

  <div class="metric">
    <span>Total Books</span>

    <strong>
      <%= metrics.totalBooks %>
    </strong>

    <small>
      All copies in inventory
    </small>
  </div>


  <div class="metric">
    <span>Available</span>

    <strong>
      <%= metrics.availableBooks %>
    </strong>

    <small>
      Ready to borrow
    </small>
  </div>


  <div class="metric">
    <span>Borrowed</span>

    <strong>
      <%= metrics.borrowedBooks %>
    </strong>

    <small>
      Active loans
    </small>
  </div>


  <div class="metric danger">
    <span>Overdue</span>

    <strong>
      <%= metrics.overdueBooks %>
    </strong>

    <small>
      Need attention
    </small>
  </div>

</div>


<section class="panel">

  <div class="panel-head">

    <div>
      <h2>Recent activity</h2>

      <p>
        Latest issue and return records.
      </p>
    </div>

    <a href="/librarian/reports">
      View reports →
    </a>

  </div>


  <div class="table-wrap">

    <table>

      <thead>

        <tr>
          <th>Book</th>
          <th>Student</th>
          <th>Issue date</th>
          <th>Due date</th>
          <th>Status</th>
        </tr>

      </thead>


      <tbody>

        <% recent.forEach(r => { %>

          <tr>

            <td>
              <strong>
                <%= r.title %>
              </strong>
            </td>

            <td>
              <%= r.student_name %>
            </td>

            <td>
              <%= r.issue_date %>
            </td>

            <td>
              <%= r.due_date %>
            </td>

            <td>
              <span class="badge <%= r.status %>">
                <%= r.status %>
              </span>
            </td>

          </tr>

        <% }) %>


        <% if (!recent.length) { %>

          <tr>

            <td
              colspan="5"
              class="muted center"
            >
              No activity yet.
            </td>

          </tr>

        <% } %>

      </tbody>

    </table>

  </div>

</section>


<%- include('../partials/layout-end') %>