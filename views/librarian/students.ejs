<%- include('../partials/layout-start',{title}) %><div class="page-header"><div><span class="eyebrow">PEOPLE</span><h1>Student Management</h1><p>Monitor accounts and borrowing activity.</p></div></div><div class="toolbar"><input class="search" data-table-search="#studentsTable" placeholder="Search name, student number, email…"></div><section class="panel"><div class="table-wrap"><table id="studentsTable"><thead><tr><th>Student</th><th>Contact</th><th>Loans</th><th>Status</th><th>Action</th></tr></thead><tbody><% students.forEach(s=>{ %><tr data-search="<%= s.name+' '+s.student_number+' '+(s.email||'') %>"><td><strong><%= s.name %></strong><small><%= s.student_number %></small></td><td><%= s.email||'—' %><small><%= s.contact_number||'—' %></small></td><td><%= s.active_borrows||0 %> active · <%= s.total_borrows||0 %> total</td><td><span class="badge <%= s.status==='active'?'available':s.status==='suspended'?'overdue':'muted-badge' %>"><%= s.status %></span></td><td><div class="action-row"><a class="btn btn-small" href="/librarian/students/<%= s.id %>">View activity</a><form method="post" action="/librarian/students/<%= s.id %>/status"><select name="status" onchange="this.form.submit()"><option value="active" <%= s.status==='active'?'selected':'' %>>active</option><option value="inactive" <%= s.status==='inactive'?'selected':'' %>>inactive</option><option value="suspended" <%= s.status==='suspended'?'selected':'' %>>suspended</option></select></form></div></td></tr><% }) %></tbody></table></div></section><%- include('../partials/layout-end') %>
